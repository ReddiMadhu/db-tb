{
  "datasets": [
    {
      "name": "claims_overview",
      "displayName": "Claims Overview",
      "catalog": "hive_metastore",
      "config": {
        "source": "SELECT cf.*, ranked.diagnosis_rank FROM hive_metastore.insurance_data.claims_fact cf JOIN (\n  SELECT `Diagnosis Category`, DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT `Claim CaseNumber`) DESC) as diagnosis_rank\n  FROM hive_metastore.insurance_data.claims_fact\n  GROUP BY `Diagnosis Category`\n) ranked ON cf.`Diagnosis Category` = ranked.`Diagnosis Category`\n",
        "measures": [
          {
            "name": "total_claims",
            "expr": "COUNT(DISTINCT `Claim CaseNumber`)"
          },
          {
            "name": "avg_duration",
            "expr": "AVG(`Business Days Duration`)"
          },
          {
            "name": "approval_rate",
            "expr": "COUNT(CASE WHEN `Benefit Status` = 'Approved' THEN `Claim CaseNumber` END) * 1.0 / COUNT(`Claim CaseNumber`)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "sum_business_days_duration",
            "expr": "SUM(`Business Days Duration`)"
          }
        ],
        "version": "1.1",
        "comment": "Migrated from Tableau workbook \"Claims Overview (1)\".\nDatasource: claims_fact (hive_metastore.insurance_data.claims_fact)+ (insurance_data)\nIncludes pre-computed diagnosis_rank for Top-N filtering.\n",
        "dimensions": [
          {
            "name": "benefit_creation_date",
            "expr": "`Benefit Creation Date`"
          },
          {
            "name": "benefit_creation_date_quarter",
            "expr": "QUARTER(`Benefit Creation Date`)"
          },
          {
            "name": "province",
            "expr": "`Province`"
          },
          {
            "name": "diagnosis_category",
            "expr": "`Diagnosis Category`"
          },
          {
            "name": "claim_casenumber",
            "expr": "`Claim CaseNumber`"
          },
          {
            "name": "benefit_type_group",
            "expr": "benefit_type_dim.`Benefit Type Group`"
          },
          {
            "name": "termination_reason",
            "expr": "`Termination Reason`"
          },
          {
            "name": "business_days_duration",
            "expr": "`Business Days Duration`"
          },
          {
            "name": "benefit_status",
            "expr": "`Benefit Status`"
          },
          {
            "name": "at_incident_occupation",
            "expr": "occupation_dim.`At Incident Occupation`"
          },
          {
            "name": "diagnosis_rank",
            "expr": "diagnosis_rank"
          }
        ],
        "joins": [
          {
            "name": "benefit_type_dim",
            "source": "hive_metastore.insurance_data.benefit_type_dim",
            "on": "source.`Benefit ID` = benefit_type_dim.`Benefit ID`",
            "cardinality": "many_to_one"
          },
          {
            "name": "occupation_dim",
            "source": "hive_metastore.insurance_data.occupation_dim",
            "on": "source.`Occupation ID` = occupation_dim.`Occupation ID`",
            "cardinality": "many_to_one"
          }
        ]
      }
    }
  ],
