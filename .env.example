# Tableau to Databricks Lakeview Migration Engine Configuration Example

PROJECT_NAME="Tableau to Databricks Lakeview Migration Engine"
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="sqlite:///./migrations.db"

# LLM Configuration (OpenAI / Azure OpenAI)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
USE_LLM_CACHE=true

# Azure OpenAI (Optional Alternative)
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Databricks Unity Catalog & Target Warehouse Connection
DATABRICKS_HOST="https://your-databricks-workspace.cloud.databricks.com"
DATABRICKS_TOKEN="dapi-your-personal-access-token"
DEFAULT_WAREHOUSE_ID="your-sql-warehouse-id"
DEFAULT_CATALOG="main"
DEFAULT_SCHEMA="default"
