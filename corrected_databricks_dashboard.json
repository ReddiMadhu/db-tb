{
  "datasets": [
    {
      "name": "c9234104",
      "displayName": "Incident_Vs_Claims___Gender_Distribution",
      "query": "SELECT `Demographics_Gender`, `StateName`, SUM(`Total_Incidents`) AS `Total_Incidents`, SUM(`Total_Claim`) AS `Total_Claim` FROM hive_metastore.default.insurance_claims_extract WHERE NOT (`Demographics_Gender` IN ('F', 'M') AND `StateName` IN ('Alaska', 'Hawaii', 'Puerto Rico')) GROUP BY 1, 2 ORDER BY 1"
    },
    {
      "name": "803d938b",
      "displayName": "Region___Claim_Ratio",
      "query": "SELECT `Region`, 'Total Claim' AS `Metric`, CAST(SUM(`Total_Claim`) AS DOUBLE) AS `Value` FROM hive_metastore.default.insurance_claims_extract GROUP BY 1 UNION ALL SELECT `Region`, 'Total Paid' AS `Metric`, CAST(SUM(`Total_Paid`) AS DOUBLE) AS `Value` FROM hive_metastore.default.insurance_claims_extract GROUP BY 1 ORDER BY 1"
    },
    {
      "name": "fec728ea",
      "displayName": "Region___Claim_Ratio__2",
      "query": "SELECT `Region`, SUM(`Total_Incidents`) AS `Total_Incidents` FROM hive_metastore.default.insurance_claims_extract GROUP BY 1 ORDER BY 1"
    },
    {
      "name": "f2acdb86",
      "displayName": "Sheet_8",
      "query": "SELECT `INCID`, `Above_Allowed_Threshold`, `Date`, `Region`, SUM(`Total_Payout`) AS `Total_Payout` FROM hive_metastore.default.insurance_claims_extract GROUP BY 1, 2, 3, 4 ORDER BY 1"
    },
    {
      "name": "32bfe874",
      "displayName": "Total_Claim_Per_Region",
      "query": "SELECT `Region`, `Demographics_Age_bin`, SUM(`Total_Claim`) AS `Total_Claim` FROM hive_metastore.default.insurance_claims_extract WHERE `Region` NOT IN ('Unknown') GROUP BY 1, 2 ORDER BY 1"
    },
    {
      "name": "e21ed429",
      "displayName": "Total_Claim_Vs_Total_Payout",
      "query": "SELECT * FROM (SELECT `StateName`, 'Total Claim' AS `Metric`, CAST(SUM(`Total_Claim`) AS DOUBLE) AS `Value` FROM hive_metastore.default.insurance_claims_extract WHERE `Claim_Paid_Ratio` >= 0.0 AND `Claim_Paid_Ratio` <= 3.1089999999999995 AND `PostalCode` NOT IN (96707.0, 96708.0, 96712.0, 96720.0, 96733.0, 96734.0, 96740.0, 96741.0, 96743.0, 96744.0, 96749.0, 96752.0, 96753.0, 96762.0, 96768.0, 96782.0, 96789.0, 96797.0, 96813.0, 96814.0, 96815.0, 96816.0, 96817.0, 96819.0, 96821.0, 96822.0, 96825.0, 96826.0, 99503.0, 99504.0, 99507.0, 99517.0, 99577.0, 99654.0, 99687.0, 99701.0, 99707.0, 99708.0, 99709.0, 99780.0, 99821.0) AND `StateName` NOT IN ('Florida') GROUP BY 1 UNION ALL SELECT `StateName`, 'Total Payout' AS `Metric`, CAST(SUM(`Total_Payout`) AS DOUBLE) AS `Value` FROM hive_metastore.default.insurance_claims_extract WHERE `Claim_Paid_Ratio` >= 0.0 AND `Claim_Paid_Ratio` <= 3.1089999999999995 AND `PostalCode` NOT IN (96707.0, 96708.0, 96712.0, 96720.0, 96733.0, 96734.0, 96740.0, 96741.0, 96743.0, 96744.0, 96749.0, 96752.0, 96753.0, 96762.0, 96768.0, 96782.0, 96789.0, 96797.0, 96813.0, 96814.0, 96815.0, 96816.0, 96817.0, 96819.0, 96821.0, 96822.0, 96825.0, 96826.0, 99503.0, 99504.0, 99507.0, 99517.0, 99577.0, 99654.0, 99687.0, 99701.0, 99707.0, 99708.0, 99709.0, 99780.0, 99821.0) AND `StateName` NOT IN ('Florida') GROUP BY 1) AS `__map_unpivot` WHERE `StateName` IN (SELECT `StateName` FROM hive_metastore.default.insurance_claims_extract WHERE `Claim_Paid_Ratio` >= 0.0 AND `Claim_Paid_Ratio` <= 3.1089999999999995 AND `PostalCode` NOT IN (96707.0, 96708.0, 96712.0, 96720.0, 96733.0, 96734.0, 96740.0, 96741.0, 96743.0, 96744.0, 96749.0, 96752.0, 96753.0, 96762.0, 96768.0, 96782.0, 96789.0, 96797.0, 96813.0, 96814.0, 96815.0, 96816.0, 96817.0, 96819.0, 96821.0, 96822.0, 96825.0, 96826.0, 99503.0, 99504.0, 99507.0, 99517.0, 99577.0, 99654.0, 99687.0, 99701.0, 99707.0, 99708.0, 99709.0, 99780.0, 99821.0) AND `StateName` NOT IN ('Florida') GROUP BY 1 ORDER BY (CAST(SUM(`Total_Claim`) AS DOUBLE) + CAST(SUM(`Total_Payout`) AS DOUBLE)) DESC LIMIT 15) ORDER BY 1"
    }
  ],
